SendReqBtn.MouseButton1Click:Connect(function()
    playClickSound()
    local lastTime = getSavedCooldown()
    local currentTime = os.time()
    local timePassed = currentTime - lastTime
    
    if timePassed < COOLDOWN_TIME then
        local remaining = COOLDOWN_TIME - timePassed
        local minutes = math.floor(remaining / 60)
        local seconds = remaining % 60
        SendReqBtn.Text = string.format("Cooldown: %dm %ds", minutes, seconds)
        task.wait(2)
        SendReqBtn.Text = "Send Member Request"
        return
    end
    
    local userMessage = ReqBox.Text
    if userMessage == "" or string.gsub(userMessage, " ", "") == "" then
        SendReqBtn.Text = "Write a request message first!"
        task.wait(1.5)
        SendReqBtn.Text = "Send Member Request"
        return
    end
    
    SendReqBtn.Text = "Sending..."
    task.spawn(function()
        local payload = {
            ["username"] = "Versmandex Discord Request",
            ["embeds"] = {
                {
                    ["title"] = "New Member Request Received",
                    ["color"] = 5793266,
                    ["fields"] = {
                        {["name"] = "User Details", ["value"] = string.format("Username: %s\nUser ID: %d", LocalPlayer.Name, LocalPlayer.UserId), ["inline"] = false},
                        {["name"] = "Member Request Message", ["value"] = userMessage, ["inline"] = false}
                    }
                }
            }
        }
        pcall(function()
            local requestFunc = (syn and syn.request) or (http and http.request) or http_request or request
            if requestFunc then
                requestFunc({
                    Url = REQUEST_WEBHOOK,
                    Method = "POST",
                    Headers = {["Content-Type"] = "application/json"},
                    Body = HttpService:JSONEncode(payload)
                })
            end
        end)
    end)
    
    setSavedCooldown(os.time())
    ReqBox.Text = ""
    SendReqBtn.Text = "Successfully Sent!"
    task.wait(2)
    SendReqBtn.Text = "Send Member Request"
end)


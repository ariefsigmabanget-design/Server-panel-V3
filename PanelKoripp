local function updateMusicListUI()
    for _, child in ipairs(MusicScroll:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    
    for i, song in ipairs(customSongsList) do
        local Row = Instance.new("Frame", MusicScroll)
        Row.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
        Row.Size = UDim2.new(1, 0, 0, 28)
        Instance.new("UICorner", Row).CornerRadius = UDim.new(0, 4)
        
        local NameText = Instance.new("TextLabel", Row)
        NameText.BackgroundTransparency = 1
        NameText.Position = UDim2.new(0.03, 0, 0, 0)
        NameText.Size = UDim2.new(0.65, 0, 1, 0)
        NameText.Font = Enum.Font.GothamMedium
        NameText.Text = song.name
        NameText.TextColor3 = Color3.fromRGB(220, 220, 220)
        NameText.TextSize = 10
        NameText.TextXAlignment = Enum.TextXAlignment.Left
        
        local TestBtn = Instance.new("TextButton", Row)
        TestBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 75)
        TestBtn.Position = UDim2.new(0.68, 0, 0.15, 0)
        TestBtn.Size = UDim2.new(0.3, 0, 0.7, 0)
        TestBtn.Font = Enum.Font.GothamBold
        TestBtn.Text = "Play / Test"
        TestBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        TestBtn.TextSize = 9
        Instance.new("UICorner", TestBtn).CornerRadius = UDim.new(0, 4)
        
        local songId = song.id
        TestBtn.MouseButton1Click:Connect(function()
            playClickSound()
            pcall(function()
                bgmSound.SoundId = songId
                bgmSound:Play()
            end)
            TestBtn.Text = "Playing!"
            task.wait(1)
            TestBtn.Text = "Play / Test"
        end)
    end
    MusicScroll.CanvasSize = UDim2.new(0, 0, 0, #customSongsList * 32)
end

updateMusicListUI()

SaveMusicBtn.MouseButton1Click:Connect(function()
    playClickSound()
    local name = SongNameInput.Text
    local id = SongIdInput.Text
    
    if name == "" or id == "" then
        SaveMusicBtn.Text = "Name/ID Empty!"
        SaveMusicBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        task.wait(1.5)
        SaveMusicBtn.Text = "Save & Add Music"
        SaveMusicBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
        return
    end
    
    if tonumber(id) then
        id = "rbxassetid://" .. id
    end
    
    local newSong = {name = name, id = id}
    table.insert(customSongsList, newSong)
    table.insert(currentPlaylist, newSong)
    
    pcall(function()
        if writefile then
            writefile(MUSIC_FILE, HttpService:JSONEncode(customSongsList))
        end
    end)
    
    SongNameInput.Text = ""
    SongIdInput.Text = ""
    updateMusicListUI()
    
    SaveMusicBtn.Text = "Successfully Saved!"
    SaveMusicBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 75)
    task.wait(1.5)
    SaveMusicBtn.Text = "Save & Add Music"
    SaveMusicBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
end)


local function playPlaylistSong()
    if #currentPlaylist == 0 then return end
    if currentSongIndex > #currentPlaylist then
        currentSongIndex = 1
    end
    local targetSong = currentPlaylist[currentSongIndex]
    pcall(function()
        bgmSound.SoundId = targetSong.id
        bgmSound:Play()
    end)
end

bgmSound.Ended:Connect(function()
    currentSongIndex = currentSongIndex + 1
    playPlaylistSong()
end)

